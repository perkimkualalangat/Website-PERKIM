# ── Wajib ──────────────────────────────────────────────
# Tukar token: revoke yang lama di GitHub, tampal yang baharu di sini,
# kemudian uji dengan  push.bat --verify
#
# Token GitHub (fine-grained, skop repo ini sahaja):
#   Settings → Developer settings → Personal access tokens → Fine-grained
#   Repository access : hanya Website-PERKIM
#   Permissions       : Contents = Read and write  (Metadata = Read, automatik)
GITHUB_TOKEN=ISI_TOKEN

# Boleh isi nama sahaja (perkimkualalangat / Website-PERKIM)
# atau URL penuh (https://github.com/perkimkualalangat/Website-PERKIM.git)
GITHUB_USER=ISI_USER
GITHUB_REPO=ISI_REPO

# ── Pilihan ────────────────────────────────────────────
GITHUB_BRANCH=main
GIT_NAME=PERKIM Kuala Langat
GIT_EMAIL=perkimkualalangat@gmail.com

# Pilihan: paksa akar projek jika skrip dipindahkan ke luar repo
# GIT_ROOT=C:\Users\rafee\Downloads\PERKIM\perkim-web

# Pilihan: fail/pattern sulit tambahan (selain .env)
# GIT_SECRET_FILES=*.sqlite,config.local.json,*.pem

# Pilihan: pattern tambahan untuk .gitignore
# GIT_IGNORE_EXTRA=node_modules,dist,*.log

# Pilihan: tunjuk URL GitHub Pages selepas push
GITHUB_PAGES=true
